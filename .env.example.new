# ========================================
# Xandeum Analytics - Environment Variables
# ========================================

# ----------------------------------------
# Database Configuration (Required)
# ----------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/xandeum_analytics

# ----------------------------------------
# Redis Configuration (Required - Upstash)
# ----------------------------------------
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxYourTokenHere

# ----------------------------------------
# pRPC Configuration (Required)
# ----------------------------------------
# Your own pNode's pRPC endpoint
# If pNode is on same VM: http://localhost:6000/rpc
# If pNode is on different VM: http://pnode-ip:6000/rpc
PRPC_URL=http://localhost:6000/rpc

# ----------------------------------------
# Authentication & Security (Required)
# ----------------------------------------
# JWT secret (min 32 characters) - generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Sync endpoint protection token - generate with: openssl rand -hex 32
# This protects the POST /pnodes/sync endpoint
SYNC_TOKEN=your_sync_token_here

# ----------------------------------------
# Server Configuration (Optional)
# ----------------------------------------
# Port for the API server
PORT=3000

# Environment mode
NODE_ENV=development

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ----------------------------------------
# CORS Configuration (Optional)
# ----------------------------------------
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------
# Application Metadata (Optional)
# ----------------------------------------
npm_package_version=1.0.0

# ========================================
# Production Notes
# ========================================
#
# 1. Never commit the actual .env file to git
# 2. Generate strong secrets: openssl rand -base64 32
# 3. Set NODE_ENV=production in production
# 4. Use internal network IPs for PRPC_URL if possible
# 5. Keep SYNC_TOKEN secret - it protects manual sync endpoint
# 6. Configure ALLOWED_ORIGINS to your frontend domains
# 7. Ensure database has proper backup strategy
# 8. Monitor Redis usage and set appropriate TTLs
#
# ========================================
