generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PNode {
  id                String    @id @default(uuid())
  ip                String    @unique  // Changed: IP is now the unique identifier
  address           String              // Full address (IP:port) - kept for reference, not unique
  pubkey            String?
  version           String?
  lastSeenTimestamp BigInt?
  lastSeen          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  activeStreams     Int?
  cpuPercent        Float?
  fileSizeBytes     BigInt?
  lastUpdatedTs     Int?
  packetsReceived   Int?
  packetsSent       Int?
  ramTotalBytes     BigInt?
  ramUsedBytes      BigInt?
  totalBytes        BigInt?
  totalPages        Int?
  uptimeSeconds     Int?

  // Geolocation (populated from IP lookup)
  latitude          Float?
  longitude         Float?
  country           String?
  city              String?

  @@index([cpuPercent])
  @@index([lastSeenTimestamp])
  @@index([version])
  @@index([address])
}
